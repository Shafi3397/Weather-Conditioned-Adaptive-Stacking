def make_err_model():
    """Small LightGBM that predicts expert expected |error| from weather features."""
    return LGBMRegressor(n_estimators=150, learning_rate=0.05, num_leaves=7, min_child_samples=30,
                         subsample=0.8, subsample_freq=1, colsample_bytree=0.8,
                         n_jobs=N_JOBS, random_state=SEED, verbose=-1)

def weights_from_E(E, p, eps=1e-3):
    W = np.power(np.maximum(E, eps), -p)
    return W / W.sum(1, keepdims=True)

def simplex_weights(P, y):
    K = P.shape[1]
    res = minimize(lambda w: np.mean((P @ w - y) ** 2), np.ones(K) / K, method="SLSQP",
                   bounds=[(0, 1)] * K, constraints={"type": "eq", "fun": lambda w: w.sum() - 1})
    if not res.success:
        raise RuntimeError(f"Voting-weight optimization failed: {res.message}")
    return res.x

def tune_p(Z_o, P_o, y_o, AE_o, conditional, gap):
    """Choose weight sharpness p using a SECOND chronological CV over the OOF rows (no leakage)."""
    folds2 = list(TimeSeriesSplit(n_splits=4, gap=gap).split(P_o))
    E_cv = np.full(AE_o.shape, np.nan)
    for tr, va in folds2:
        if conditional:
            for j in range(AE_o.shape[1]):
                E_cv[va, j] = make_err_model().fit(Z_o.iloc[tr], AE_o[tr, j]).predict(Z_o.iloc[va])
        else:
            E_cv[va] = AE_o[tr].mean(0)
    m = ~np.isnan(E_cv[:, 0])
    scores = {p: np.sqrt(np.mean((y_o[m] - (weights_from_E(E_cv[m], p) * P_o[m]).sum(1)) ** 2)) for p in P_GRID}
    return min(scores, key=scores.get)

def run_adaptive(cols, conditional, Z_o, Z_te, P_o, y_o, AE_o, P_te, gap):
    p = tune_p(Z_o[cols] if conditional else Z_o, P_o, y_o, AE_o, conditional, gap)
    if conditional:
        E_te = np.column_stack([make_err_model().fit(Z_o[cols], AE_o[:, j]).predict(Z_te[cols])
                                for j in range(AE_o.shape[1])])
    else:
        E_te = np.tile(AE_o.mean(0), (len(P_te), 1))
    W = weights_from_E(E_te, p)
    return (W * P_te).sum(1), W, E_te, p

def block_boot_delta(e_base, e_new, block=168, B=1000, seed=SEED, chunk=250):
    """95 % CI of RMSE(base) - RMSE(new) using a moving-block bootstrap (positive = new is better).
    Block = 168 h (one week) because hourly errors are strongly autocorrelated."""
    rng = np.random.default_rng(seed); n = len(e_base); nb = int(np.ceil(n / block)); out = []
    for _ in range(B // chunk):
        starts = rng.integers(0, n - block + 1, size=(chunk, nb))
        ii = (starts[:, :, None] + np.arange(block)).reshape(chunk, -1)[:, :n]
        out.append(np.sqrt((e_base[ii] ** 2).mean(1)) - np.sqrt((e_new[ii] ** 2).mean(1)))
    return np.percentile(np.concatenate(out), [2.5, 97.5])

