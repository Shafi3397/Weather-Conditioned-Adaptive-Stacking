# %% 5. Models 
class SubsampledSVR(BaseEstimator, RegressorMixin):
    """Scaled SVR trained on an evenly spaced subsample (keeps kernel SVR tractable on ~50k hourly rows)."""
    def __init__(self, C=3.0, epsilon=0.1, max_samples=SVR_MAX_N):
        self.C, self.epsilon, self.max_samples = C, epsilon, max_samples
    def fit(self, X, y):
        X, y = np.asarray(X), np.asarray(y)
        sel = np.linspace(0, len(X) - 1, min(len(X), self.max_samples)).astype(int)
        self.model_ = TransformedTargetRegressor(
            regressor=make_pipeline(StandardScaler(), SVR(C=self.C, epsilon=self.epsilon, gamma="scale")),
            transformer=StandardScaler()).fit(X[sel], y[sel])
        return self
    def predict(self, X):
        return self.model_.predict(np.asarray(X))

def make_experts():
    """Base experts used by every ensemble (identical for fair comparison)."""
    return {
        "Random Forest": RandomForestRegressor(n_estimators=200, min_samples_leaf=3, max_features=0.4,
                                               n_jobs=N_JOBS, random_state=SEED),
        "SVR": SubsampledSVR(C=3.0, epsilon=0.1),
        "XGBoost": XGBRegressor(n_estimators=400, learning_rate=0.05, max_depth=5, subsample=0.8,
                                colsample_bytree=0.7, reg_lambda=1.0, n_jobs=N_JOBS,
                                random_state=SEED, verbosity=0),
        "LightGBM": LGBMRegressor(n_estimators=500, learning_rate=0.05, num_leaves=31, subsample=0.8,
                                  subsample_freq=1, colsample_bytree=0.7, min_child_samples=30,
                                  importance_type="gain", n_jobs=N_JOBS, random_state=SEED, verbose=-1),
        "CatBoost": CatBoostRegressor(iterations=600, learning_rate=0.08, depth=6, random_seed=SEED,
                                      verbose=0, thread_count=N_JOBS),
    }

